{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsc && tsc-alias",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/src/index.js",
		"db:push": "prisma db push --schema ./prisma/schema",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@hono/trpc-server": "^0.3.4",
		"@prisma/client": "^6.6.0",
		"@trpc/server": "^11.0.0",
		"better-auth": "^1.2.6",
		"dotenv": "^16.4.7",
		"hono": "^4.7.6",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@types/bun": "^1.2.6",
		"@types/node": "^20",
		"prisma": "^6.6.0",
		"tsc-alias": "^1.8.11",
		"typescript": "^5.8.2"
	}
}
